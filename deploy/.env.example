# Copy to deploy/.env and replace EVERY value. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SCRIPTORIUM_ENVIRONMENT=production
SCRIPTORIUM_PUBLIC_BASE_URL=https://scriptorium.example.org
SCRIPTORIUM_SECRET_KEY=change-me-to-a-48-char-random-secret-xxxxxxxxxxxxxxxx
SCRIPTORIUM_COOKIE_SECURE=true
SCRIPTORIUM_ALLOW_SELF_REGISTRATION=false
SCRIPTORIUM_HTTP_PORT=3000

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=scriptorium
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

SCRIPTORIUM_MAIL_BACKEND=smtp
SCRIPTORIUM_SMTP_HOST=smtp.example.org
SCRIPTORIUM_SMTP_PORT=587
SCRIPTORIUM_SMTP_USERNAME=
SCRIPTORIUM_SMTP_PASSWORD=
SCRIPTORIUM_MAIL_FROM=SCRIPTORIUM <no-reply@example.org>

# Phase 7 — production hardening
SCRIPTORIUM_DOMAIN=scriptorium.example.org      # used by the optional "tls" profile (Caddy)
SCRIPTORIUM_MALWARE_SCANNER=clamd               # clamd (default) | none — uploads refused while clamd is down
SCRIPTORIUM_HSTS_SECONDS=31536000               # served over TLS only
SCRIPTORIUM_EXPORT_RETENTION_DAYS=30            # institutions may override in their storage policy
SCRIPTORIUM_ORPHAN_GRACE_DAYS=7
