# SCRIPTORIUM web frontend (Next.js standalone output).
FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
RUN groupadd --system --gid 10001 scriptorium && useradd --system --uid 10001 --gid scriptorium scriptorium
WORKDIR /web
COPY --from=build --chown=scriptorium:scriptorium /web/.next/standalone ./
COPY --from=build --chown=scriptorium:scriptorium /web/.next/static ./.next/static
USER scriptorium
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
