# SCRIPTORIUM worker image — Kraken 7.1.1 + PyTorch (CPU wheels by default).
# For GPU nodes, build with --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu126
FROM python:3.12-slim-bookworm
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libvips42 poppler-utils fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 scriptorium \
    && useradd --system --uid 10001 --gid scriptorium --home /app scriptorium
WORKDIR /app
RUN pip install --upgrade pip && pip install --extra-index-url "${TORCH_INDEX}" "torch>=2.9,<=2.14" "torchvision"
COPY backend/ ./
# Security (Phase 7): kraken 7.1.1 pins lightning==2.6.1, affected by CVE-2026-58659 (RCE when loading
# crafted checkpoints). 2.6.6 contains the fix; it is installed over the pin and verified by the real
# recognition and fine-tuning test suites (docs/reports/phase-7.md). Remove once kraken relaxes the pin.
RUN pip install ".[worker]" && pip install --no-deps "lightning==2.6.6" && kraken --version \
    && mkdir -p /data/storage /data/models /data/outbox && chown -R scriptorium:scriptorium /data
USER scriptorium
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
  CMD celery -A app.worker.celery_app inspect ping -d "celery@$HOSTNAME" -t 10 || exit 1
CMD ["celery", "-A", "app.worker.celery_app", "worker", "-Q", "default,recognition,models", "--concurrency", "1", "--loglevel", "INFO"]
