    family-names: "Medeiros Souza"
    email: scmedeirossouza@gmail.com
    orcid: "https://orcid.org/0009-0001-2853-1140"
    affiliation: "Independent Researcher"
version: 0.1.0
date-released: 2026-11-19
license: Apache-2.0
repository-code: "https://github.com/SeanMedeiros/scriptorium"
keywords:
  - digital humanities
  - handwritten text recognition
  - HTR
  - OCR
  - Kraken
  - paleography
  - TEI
  - archives
